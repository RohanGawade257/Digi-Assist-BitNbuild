# Development template only. Activate after creating the workspace and pnpm-lock.yaml.
# Pin the tested Node image digest and exact pnpm version before the implementation release.
FROM node:24-bookworm-slim
RUN npm install --global pnpm@10.15.1
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ARG APP_FILTER
ENV APP_FILTER=${APP_FILTER}
CMD ["sh", "-c", "exec pnpm --filter \"$APP_FILTER\" dev"]
