{
  "name": "digital-assistant", "version": "0.1.0", "private": true,
  "packageManager": "pnpm@10.30.3", "engines": { "node": ">=22.20.0 <25" },
  "scripts": {
    "dev": "pnpm --filter @guide/contracts build && pnpm --parallel --filter @guide/api --filter @guide/web dev",
    "build": "pnpm --filter @guide/contracts build && pnpm --filter @guide/api build && pnpm --filter @guide/web build",
    "typecheck": "pnpm --filter @guide/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @guide/contracts build && pnpm --filter @guide/api test && pnpm --filter @guide/web test",
    "test:browser": "playwright test",
    "docs:api": "pnpm --filter @guide/contracts build && node scripts/export-openapi.cjs",
    "check:docs": "node scripts/localize-ui.cjs && node scripts/export-openapi.cjs --check",
    "test:integration": "pnpm --filter @guide/contracts build && pnpm --filter @guide/api test:integration"
  },
  "devDependencies": { "typescript": "5.9.3", "@types/node": "22.19.15", "@playwright/test": "1.58.2", "@axe-core/playwright": "4.11.1" },
  "pnpm": { "overrides": { "@nestjs/platform-express>multer": "2.3.0", "gaxios>uuid": "11.1.1" } }
}
