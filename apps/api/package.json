{
  "name": "@guide/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build && node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.cjs",
    "test:integration": "pnpm build && node --env-file=../../.env --test test/integration.cjs",
    "probe:config": "pnpm build && node --env-file-if-exists=../../.env dist/probe.js",
    "probe:local": "pnpm build && node --env-file-if-exists=../../.env dist/probe.js --local-only"
  },
  "dependencies": {
    "@guide/contracts": "workspace:*",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "express": "5.2.1",
    "firebase-admin": "14.4.0",
    "mongodb": "7.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.6"
  }
}
