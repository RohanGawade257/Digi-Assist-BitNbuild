# Local development only. Run scripts/setup-local.ps1 to generate a Mongo password.
MONGO_ROOT_USERNAME=guide_admin
MONGO_ROOT_PASSWORD=
MONGO_PORT=27018
MONGODB_URI=
MONGO_DATABASE=digital_assistant
PORT=3001
API_ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=
# Host API resolves relative paths from apps/api; Compose uses /run/secrets.
GOOGLE_APPLICATION_CREDENTIALS=../../secrets/firebase-admin.json
REQUIRE_EMAIL_VERIFIED=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
GEMINI_MODEL=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_QUOTA_GROUP_1=gemini-main
GEMINI_QUOTA_GROUP_2=gemini-main
GEMINI_QUOTA_GROUP_3=gemini-main
GEMINI_QUOTA_GROUP_4=gemini-main
SARVAM_API_KEY_1=
SARVAM_API_KEY_2=
SARVAM_API_KEY_3=
SARVAM_QUOTA_GROUP_1=sarvam-main
SARVAM_QUOTA_GROUP_2=sarvam-main
SARVAM_QUOTA_GROUP_3=sarvam-main
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
QUOTA_POLICY_PATH=../../config/quota-policy.json
PERSIST_RAW_MEDIA=false
HISTORY_DEFAULT_ENABLED=false
